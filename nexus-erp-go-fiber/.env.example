# NexusERP Go Fiber API Configuration

# Application Settings
APP_ENV=development
PORT=8080
HOST=0.0.0.0
DEBUG=true

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=nexus_user
DB_PASSWORD=nexus_secure_password
DB_NAME=nexus_erp
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h
JWT_REFRESH_SECRET=your-refresh-secret-key-here-change-in-production

# Email Configuration (optional)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@nexuserp.com
FROM_NAME=NexusERP

# External Service API Keys (optional)
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=
STRIPE_SECRET_KEY=

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Performance Tuning
GOMAXPROCS=0
GOMEMLIMIT=512MiB

# Security Configuration
TRUSTED_PROXIES=127.0.0.1,::1
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Development/Testing
MOCK_EXTERNAL_SERVICES=true
ENABLE_PROFILING=false
ENABLE_METRICS=true