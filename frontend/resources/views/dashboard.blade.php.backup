    <!-- AI 助手 JavaScript 模組 -->
    <script src="{{ asset('js/modules/ai-chat.js') }}"></script>
    <script src="{{ asset('js/components/ai/AIChatWindow.js') }}"></script>

    <script>
    // 簡化的儀表板控制器
    class DashboardController {
        constructor() {
            this.init();
        }

        async init() {
            try {
                await this.loadDashboardData();
                this.hideLoading();
                this.renderDashboard();
            } catch (error) {
                this.showError(error.message);
            }
        }

        async loadDashboardData() {
            try {
                // 載入真實的儀表板統計資料
                const response = await fetch('/api/dashboard/stats', {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                    }
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();
                
                if (result.success) {
                    this.data = {
                        sales: { total_sales: 0, order_count: 0 }, // TODO: 實作銷售統計
                        inventory: {
                            total_value: result.data.inventory.total_value || 0,
                            low_stock_count: result.data.inventory.low_stock_count || 0,
                            out_of_stock_count: result.data.inventory.out_of_stock_count || 0
                        },
                        financial: { total_ar: 0, overdue_ar: 0, cash_flow: 0 }, // TODO: 實作財務統計
                        overview: result.data.overview || {},
                        generated_at: result.data.generated_at || new Date().toISOString()
                    };
                } else {
                    throw new Error(result.message || '載入資料失敗');
                }

            } catch (error) {
                console.error('Dashboard load error:', error);
                // 回退到預設資料，但顯示錯誤
                this.data = {
                    sales: { total_sales: 0, order_count: 0 },
                    inventory: { total_value: 0, low_stock_count: 0 },
                    financial: { total_ar: 0, overdue_ar: 0, cash_flow: 0 },
                    generated_at: new Date().toISOString()
                };
                throw error; // 重新拋出錯誤讓上層處理
            }
        }

        hideLoading() {
            document.getElementById('loading').classList.add('hidden');
            document.getElementById('dashboard-content').classList.remove('hidden');
            document.getElementById('last-updated').classList.remove('hidden');
        }

        showError(message) {
            document.getElementById('loading').classList.add('hidden');
            document.getElementById('error').classList.remove('hidden');
            document.getElementById('error-message').textContent = message;
        }

        renderDashboard() {
            this.renderKPIs();
            this.updateTimestamp();
        }

        renderKPIs() {
            const { sales, inventory, financial } = this.data;

            if (sales) {
                document.getElementById('total-sales').textContent = this.formatCurrency(sales.total_sales || 0);
                document.getElementById('orders-count').textContent = `${sales.order_count || 0} 筆訂單`;
            }

            if (inventory) {
                document.getElementById('inventory-value').textContent = this.formatCurrency(inventory.total_value || 0);
                document.getElementById('low-stock-alert').textContent = `${inventory.low_stock_count || 0} 項低庫存`;
            }

            if (financial) {
                document.getElementById('total-ar').textContent = this.formatCurrency(financial.total_ar || 0);
                document.getElementById('overdue-ar').textContent = `$${this.formatNumber(financial.overdue_ar || 0)} 逾期`;
                document.getElementById('cash-flow').textContent = this.formatCurrency(financial.cash_flow || 0);
                
                const cashFlowElement = document.getElementById('cash-flow');
                if (financial.cash_flow > 0) {
                    cashFlowElement.classList.add('text-green-600');
                } else if (financial.cash_flow < 0) {
                    cashFlowElement.classList.add('text-red-600');
                }
            }

            // 渲染公司快速統計
            this.renderCompanyStats();
        }

        renderCompanyStats() {
            // 公司快速統計數據（示例數據，實際應從 API 載入）
            const companyStats = {
                active_orders: this.data.sales?.order_count || 0,
                total_products: this.data.inventory?.total_items || 0,
                total_customers: this.data.overview?.total_customers || 0
            };

            // 更新公司統計顯示
            const activeOrdersElement = document.getElementById('company-active-orders');
            const totalProductsElement = document.getElementById('company-total-products');
            const totalCustomersElement = document.getElementById('company-total-customers');

            if (activeOrdersElement) {
                activeOrdersElement.textContent = this.formatNumber(companyStats.active_orders);
            }

            if (totalProductsElement) {
                totalProductsElement.textContent = this.formatNumber(companyStats.total_products);
            }

            if (totalCustomersElement) {
                totalCustomersElement.textContent = this.formatNumber(companyStats.total_customers);
            }
        }

        updateTimestamp() {
            const timestamp = new Date(this.data.generated_at).toLocaleString('zh-TW');
            document.getElementById('update-timestamp').textContent = timestamp;
        }

        formatCurrency(amount) {
            return new Intl.NumberFormat('zh-TW', {
                style: 'currency',
                currency: 'TWD',
                minimumFractionDigits: 0,
                maximumFractionDigits: 0
            }).format(amount);
        }

        formatNumber(number) {
            return new Intl.NumberFormat('zh-TW').format(number);
        }
    }

    // 頁面載入完成後初始化儀表板
    document.addEventListener('DOMContentLoaded', function() {
        new DashboardController();
    });
    </script>
@endsection
