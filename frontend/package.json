{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "playwright test --config=../playwright.config.enhanced.js",
        "test:headed": "playwright test --config=../playwright.config.enhanced.js --headed",
        "test:debug": "playwright test --config=../playwright.config.enhanced.js --debug",
        "test:report": "playwright show-report ../test-results/html-report",
        "test:comprehensive": "node ../run-comprehensive-tests.js",
        "test:comprehensive:parallel": "node ../run-comprehensive-tests.js --parallel",
        "test:auth": "node ../run-comprehensive-tests.js --suite=auth",
        "test:customers": "node ../run-comprehensive-tests.js --suite=customers",
        "test:products": "node ../run-comprehensive-tests.js --suite=products",
        "test:suppliers": "node ../run-comprehensive-tests.js --suite=suppliers",
        "test:sales": "node ../run-comprehensive-tests.js --suite=salesOrders"
    },
    "devDependencies": {
        "@playwright/test": "^1.54.1",
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/typography": "^0.5.16",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.8.2",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^1.2.0",
        "playwright": "^1.54.2",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^6.2.4"
    },
    "dependencies": {
        "puppeteer": "^24.15.0"
    }
}
